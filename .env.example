# Django Security & Core Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=agriconnect.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://agriconnect.onrender.com

# MongoDB Cloud Database (MongoDB Atlas)
# Replace with your actual Atlas connection string:
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agriconnect

# Optional: Python runtime version for hosting providers (e.g., Render)
PYTHON_VERSION=3.12.8
